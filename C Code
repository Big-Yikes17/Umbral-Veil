/* ============================================================
 *  MAP ROWS
 * ============================================================ */
static const char* frows[5] = {
    "  # # # # #",
    "  # . . . #",
    "  E . I . #",
    "  # . . . #",
    "  # # # # #"
};
static const char* trows[5] = {
    "  # # # # #",
    "  # . . B #",
    "  # . . . #",
    "  # . . . #",
    "  # # E # #"
};

/* ============================================================
 *  MAP DISPLAY
 * ============================================================ */
static void show_map(int map_area, int player_row,
                     int item_found, int boss_found) {
    int r, col, placed;
    const char* row;
    char ch;
    print_line();
    if (map_area == 0) {
        printf("  AREA 1: RUINED VILLAGE MAP\n\n"); flush();
        for (r = 0; r < 5; r++) {
            row = frows[r];
            placed = 0; col = 0;
            while (row[col] != '\0') {
                ch = row[col];
                if (r == player_row && ch == '.' && !placed) {
                    putchar('P'); placed = 1;
                } else if (ch == 'I' && item_found) {
                    putchar('.');
                } else {
                    putchar(ch);
                }
                col++;
            }
            printf("\n"); flush();
        }
        printf("\n  LEGEND: E=Entrance  I=Item  P=You  #=Ruins\n"); flush();
        if (!item_found) {
            printf("  KEY ITEM: Broken Sword [I] - not found\n"); flush();
        } else {
            printf("  KEY ITEM: Broken Sword [I] - COLLECTED!\n"); flush();
        }
    } else {
        printf("  AREA 2: SHADOW GATE MAP\n\n"); flush();
        for (r = 0; r < 5; r++) {
            row = trows[r];
            placed = 0; col = 0;
            while (row[col] != '\0') {
                ch = row[col];
                if (r == player_row && ch == '.' && !placed) {
                    putchar('P'); placed = 1;
                } else if (ch == 'B' && boss_found) {
                    putchar('X');
                } else {
                    putchar(ch);
                }
                col++;
            }
            printf("\n"); flush();
        }
        printf("\n  LEGEND: E=Entrance  B=Boss  P=You  X=Defeated\n"); flush();
        if (!boss_found) {
            printf("  KEY ITEM: Ancient Guardian [B] - not defeated\n"); flush();
        } else {
            printf("  KEY ITEM: Ancient Guardian [B] - DEFEATED!\n"); flush();
        }
    }
    print_line();
}

/* ============================================================
 *  PUZZLE 1 - Shadow Altar  (answer: 3)
 * ============================================================ */
static int puzzle_symbol(int difficulty) {
    int hints = get_puzzle_threshold(difficulty);
    print_line();
    printf("  PUZZLE 1 - THE SHADOW ALTAR\n\n"); flush();
    printf("  Dark whispers echo from the altar:\n\n"); flush();
    printf("  'I have cities but no houses live there.\n"); flush();
    printf("   I have mountains but no trees grow.\n"); flush();
    printf("   I have water but no fish swim.\n"); flush();
    printf("   Speak my name to gain shadow magic.'\n\n"); flush();
    if (hints >= 2) { printf("  HINT 1: You can hold it in your hands.\n"); flush(); }
    if (hints >= 2) { printf("  HINT 2: Travelers use it before a journey.\n"); flush(); }
    if (hints >= 3) { printf("  HINT 3: It shows you where to go.\n"); flush(); }
    printf("\n"); flush();
    printf("  1) A Dream\n"); flush();
    printf("  2) A Mirror\n"); flush();
    printf("  3) A Map\n"); flush();
    printf("  4) A Clock\n\n"); flush();
    printf("  PLAYER ANSWERS: 3\n"); flush();
    if (check_answer(3, 3)) {
        printf("  CORRECT! Shadow Magic gained!\n\n"); flush();
        return 1;
    }
    return 0;
}

