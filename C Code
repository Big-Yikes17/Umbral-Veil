    printf("  Solve the sequence to unlock the gate.\n\n"); flush();
    if (hints >= 2) { printf("  HINT 1: Each number doubles.\n"); flush(); }
    if (hints >= 3) { printf("  HINT 2: 8 x 2 = ?\n"); flush(); }
    printf("\n"); flush();
    printf("  PLAYER ANSWERS: 16\n"); flush();
    if (check_answer(16, 16)) {
        printf("  CORRECT! The gate creaks open!\n"); flush();
        printf("  A Veil Crystal drops to the ground!\n\n"); flush();
        return 1;
    }
    return 0;
}

